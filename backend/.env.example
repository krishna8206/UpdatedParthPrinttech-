# Server Port
PORT=5000

# Cloud Database Persistence (MongoDB Atlas Free M0 Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/parth_printtech?retryWrites=true&w=majority
MONGODB_URI=

# Cloud Permanent Media Storage (Cloudinary Free Tier)
# Option A: Full Cloudinary URL
# Example: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Option B: Individual Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
